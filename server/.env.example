# Copy this file to .env and fill in real values before running docker compose up.
# Never commit the real .env file to git.

# A long random string used to sign login sessions. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Password for the Postgres database user this app creates for itself.
# Generate one with: openssl rand -base64 24
POSTGRES_PASSWORD=

# Port on the HOST machine that the app is reachable on (http://<server>:APP_PORT).
APP_PORT=8080

# Set to false ONLY if this server is reachable exclusively over plain http on a trusted internal
# network with no TLS anywhere in front of it (no reverse proxy terminating https either). If
# there's any TLS termination in front of this app (a reverse proxy, load balancer, etc.), leave
# this true and set TRUST_PROXY=true instead below.
COOKIE_SECURE=true

# Set to true if this app sits behind a reverse proxy (nginx, an internal load balancer, etc.)
# that terminates TLS and forwards plain http to this container.
TRUST_PROXY=false

# Only used the very first time the app starts against an empty database: true loads the demo
# roster (300 sample employees) so there's something to look at; false starts with no employees.
SEED_DEMO_DATA=true
